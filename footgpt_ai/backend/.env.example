DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
# Local without Postgres:
# DJANGO_USE_SQLITE=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5050
# Production: DJANGO_DEBUG=False, set real hosts, and optionally:
# DJANGO_SECURE_HSTS_SECONDS=31536000

POSTGRES_DB=footgpt
POSTGRES_USER=footgpt
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# API-Football (api-sports). Keep this file on the server only.
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_KEY=
# Set FOOTBALL_API_HOST only if you use RapidAPI, e.g. v3.football.api-sports.io
FOOTBALL_API_HOST=
# OpenAI — used only by Django. Never put this in Flutter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# FCM HTTP v1 — path to a Google service-account JSON on the server only.
# Leave empty until Firebase is provisioned. Never put this in Flutter.
FIREBASE_CREDENTIALS_FILE=
